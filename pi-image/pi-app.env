# ---------------------------------------------------------------------------
# Deployment manifest.
#
# This is the whole per-project interface. build.sh, cscript.sh, firstboot.sh
# and the tests are shared verbatim with transfer_station; only this file
# differs between the two instruments.
#
# Values here are BAKED INTO THE IMAGE as defaults. The network settings are
# also the defaults the flasher offers at the prompt, so a card can be
# re-addressed at write time without rebuilding the image -- see firstboot.sh.
# ---------------------------------------------------------------------------

# --- identity -------------------------------------------------------------
APP_NAME=syringe-pump
PI_HOSTNAME=syringe-pump
PI_USER=chorylab

# Password for PI_USER. Override at build time:  PI_PASSWORD=... ./build.sh
# Never commit a real one -- this repository is public. The flasher can also
# set it per card, which is preferable: it never touches git at all.
PI_PASSWORD=changeme

# Optional SSH public key. Preferred over a password; a public key in a public
# repo is harmless by design.
PI_SSH_PUBKEY=

# --- where the app lives --------------------------------------------------
REPO_DEST=/home/chorylab/syringe_pump

# --- what to install ------------------------------------------------------
# apt packages. Pure-Python dependencies belong in the frozen server project
# below; only C extensions and services need to come from apt.
APT_PACKAGES=redis-server,python3-rpi.gpio

# The frozen Python environment for the server, relative to the repo root.
# Deliberately NOT the repository's own pyproject.toml: motor_server.py needs
# only flask/flask-caching/redis, while the repo's metadata also requires
# agrow-pumps -- controller-side Modbus code that never runs on the Pi and is
# not published on PyPI, so locking it would make the image unbuildable.
SERVER_PROJECT=pi-image/server

# Modules that must be importable in the finished venv. Checked at build time
# and again by the image audit, so a broken environment fails the build rather
# than the instrument.
PYTHON_IMPORTS=flask,flask_caching,redis

# Paths excluded from the copy into the image. Build-time-only directories and
# anything that would ship stale state to the instrument.
REPO_EXCLUDES=./.git,./pi-image,./build,./syringe_pump.egg-info,./syringe_pump/syringe,__pycache__,*.pyc,./dump.rdb

# --- what to run ----------------------------------------------------------
# ${VENV} and ${REPO_DEST} are substituted by build.sh. $PUMP_PORT and
# $MOTOR_ARGS are NOT -- they are left for systemd to expand from the
# EnvironmentFile, which is what makes the port and the motor set settable at
# write time instead of only at build time.
#
# motor_server.py is run by path rather than as a module on purpose: it does
# `from A4988 import A4988Nema`, so Python must put its own directory on
# sys.path, which running the file directly does and `-m` would not.
APP_EXEC='${VENV}/bin/python ${REPO_DEST}/syringe_pump/motor_server.py --host=0.0.0.0 --port=$PUMP_PORT $MOTOR_ARGS'
SERVICE_REQUIRES=redis-server.service

# --- motors ---------------------------------------------------------------
# One entry per independently controllable motor, space separated:
#
#   <id>:<dir>,<step>,<ms1>,<ms2>,<ms3>      BCM numbering
#   <id>:<dir>,<step>                        MS1/MS2/MS3 strapped in hardware
#
# The id appears in the URL (/motor/<id>/run) and in the Redis stop key, so
# each motor is commanded and stopped on its own. Drop the second entry for a
# single-motor pump; the flasher can also do that per card, so one image
# serves both.
#
# Motor a keeps the pins motor_server.py's argparse already defaulted to.
# Those disagreed with MotorServer.__init__'s own defaults (20/21 and
# 14,15,18), so declaring them here leaves one answer instead of two. Motor b
# avoids the I2C (2,3), SPI (7-11) and UART (14,15) lines, so adding it costs
# no bus.
MOTORS='a:22,23,17,27,25 b:5,6,13,19,26'

# --- network --------------------------------------------------------------
# Defaults only: the flasher prompts for these and writes what you choose to
# the card's boot partition, where firstboot.sh applies it.
#
# ETH_ADDRESS is the address the client code already hardcodes
# (syringe_pump/curl_requests.py, syringe_pump/syringe.py). Unlike the
# transfer station's 192.168.10.1 this is a lab-LAN address, so CHECK THE
# PREFIX against your actual subnet before flashing -- 24 is an assumption,
# and a 10.x network is often wider. The prompt is the place to correct it.
ETH_IFACE=eth0
ETH_ADDRESS=10.194.22.184
ETH_PREFIX=24

# Leave both EMPTY for an isolated link: with no default route and no DNS on
# this interface the Pi cannot reach, or be reached from, anything but hosts
# on the same switch. Set them only if the instrument must sit on a routed
# LAN -- note that motor_server.py has NO authentication, so on a shared
# network anyone who can reach the port can drive the pump.
ETH_GATEWAY=
ETH_DNS=

SERVER_PORT=5000

# --- misc -----------------------------------------------------------------
TIMEZONE=America/Los_Angeles
GROW_MB=2048

# --- pinned inputs --------------------------------------------------------
# Every external input to the build is pinned. An image is only debuggable if
# rebuilding it a month later produces the same thing: with floating inputs,
# "it worked in August and not in October" has no bisectable cause. Moving any
# of these is a deliberate, reviewable commit.
#
# Raspberry Pi OS Lite 64-bit, by dated URL rather than raspios_lite_arm64_latest.
# The checksum is the one published beside the image; build.sh refuses a
# mismatch rather than customising something it did not expect.
IMAGE_URL=https://downloads.raspberrypi.com/raspios_lite_arm64/images/raspios_lite_arm64-2026-06-19/2026-06-18-raspios-trixie-arm64-lite.img.xz
IMAGE_SHA256=acff736ca7945e3b305f07cda4abdb870910e12634991da69783611756e381b3

# sdm, by release tag. The installer itself is fetched by commit, not from
# master -- otherwise the pin only covers half the supply chain. build.sh
# checks the version it actually got.
SDM_VERSION=V15.8
SDM_COMMIT=5a63de1e8f118772483e931c1ad8ac49bf104dd9

# uv, by version. The installer honours a version in its URL.
UV_VERSION=0.12.5
